{
    // Author: Mohammad Rashiqul Alam
    // Workspace settings for S32K144EVB-Q100 development.

    // Skip the "Errors exist after running preLaunchTask" prompt.
    // CMakeUserPresets.json reports missing x86 generator files when the
    // x86 build hasn't been configured — these are unrelated to ARM debugging.
    "debug.onTaskErrors": "debugAnyway",

    // Disable semantic highlighting so cpptools/clangd don't override the
    // default Dark theme token colours (functions, macros, types etc.).
    "editor.semanticHighlighting.enabled": true,

    // Point cpptools and SonarQube at the ARM build's compile_commands.json.
    // Generated by CMake (-DCMAKE_EXPORT_COMPILE_COMMANDS=ON) during make build_all_tgt.
    // This gives IntelliSense and SonarQube the correct include paths, defines,
    // and compiler flags for the S32K144 ARM target.
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build_s32k1/build_armv7/RelWithDebInfo/compile_commands.json",
    "sonarlint.pathToCompileCommands": "${workspaceFolder}/build_x86_64/Debug/compile_commands.json"
}
